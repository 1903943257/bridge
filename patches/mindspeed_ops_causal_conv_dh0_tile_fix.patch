 class TestCausalConv1dState:
     """initial_state / final_state semantics and gradient propagation."""
 
+    @pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+    @pytest.mark.parametrize("activation", [None, "silu"])
+    def test_short_tile_split_backward_relay(self, monkeypatch, dtype, activation):
+        """Reproduce Stage 3.2's 6144-channel 64+64 full vs split conv relay."""
+        import mindspeed_ops.arch32.triton.convolution as convolution
+
+        monkeypatch.setattr(convolution, "get_vector_num", lambda: 32)
+        torch.manual_seed(3212)
+        x_full = torch.randn(1, 128, 6144, dtype=dtype, device=DEVICE, requires_grad=True)
+        w_full = (torch.randn(4, 6144, dtype=dtype, device=DEVICE) * 0.1).requires_grad_(True)
+        dy = torch.randn_like(x_full)
+        full_output, _ = causal_conv1d(x_full, w_full, activation=activation, output_final_state=True)
+        full_output.backward(dy)
+
+        x_prefix = x_full[:, :64].detach().clone().requires_grad_(True)
+        x_suffix = x_full[:, 64:].detach().clone().requires_grad_(True)
+        w_split = w_full.detach().clone().requires_grad_(True)
+        with torch.no_grad():
+            pushed, saved = causal_conv1d(x_prefix, w_split, activation=activation, output_final_state=True)
+        anchor = saved.detach().clone().requires_grad_(True)
+        suffix_output, _ = causal_conv1d(
+            x_suffix, w_split, initial_state=anchor, activation=activation, output_final_state=True
+        )
+        suffix_output.backward(dy[:, 64:])
+        assert anchor.grad is not None
+        prefix_output, final_state = causal_conv1d(
+            x_prefix, w_split, activation=activation, output_final_state=True
+        )
+        torch.autograd.backward((prefix_output, final_state), (dy[:, :64], anchor.grad))
+
+        # Independently validate the suffix state derivative with CPU autograd.
+        h0_ref = saved.detach().cpu().float().requires_grad_(True)
+        suffix_ref = causal_conv1d_ref(
+            x_suffix.detach().cpu().float(), w_split.detach().cpu().float(),
+            initial_state=h0_ref, activation=activation,
+        )
+        suffix_ref.backward(dy[:, 64:].cpu().float())
+        tolerance = 5e-2 if dtype == torch.bfloat16 else 1e-4
+        comparisons = {
+            "output": (full_output, torch.cat((pushed, suffix_output), dim=1)),
+            "dx": (x_full.grad, torch.cat((x_prefix.grad, x_suffix.grad), dim=1)),
+            "dw": (w_full.grad, w_split.grad),
+            "dh0": (h0_ref.grad, anchor.grad),
+        }
+        for name, (reference, actual) in comparisons.items():
+            assert reference is not None and actual is not None, name
+            reference, actual = reference.detach().cpu().float(), actual.detach().cpu().float()
+            assert torch.isfinite(actual).all(), name
+            torch.testing.assert_close(actual, reference, atol=tolerance, rtol=tolerance, msg=name)
+        torch.testing.assert_close(anchor.grad[:, :, 0], torch.zeros_like(anchor.grad[:, :, 0]), atol=0, rtol=0)
+
