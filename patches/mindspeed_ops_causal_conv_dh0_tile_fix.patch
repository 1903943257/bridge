+    @pytest.mark.parametrize("bt", [1, 2, 4, 8])
+    @pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+    @pytest.mark.parametrize("activation", [None, "silu"])
+    def test_initial_state_gradient_across_tiles(self, monkeypatch, bt, dtype, activation):
+        """Cover BT<W, BT=W and BT>W with the existing dx/dw/dh0 oracle."""
+        import mindspeed_ops.arch32.triton.convolution as convolution
+
+        # Controlled launch grid, not the physical core count. For B=1,T=64,
+        # the unchanged tile heuristic chooses BT=bt. Keep allocation and launch
+        # sizing consistent by changing its input rather than overriding kernel BT.
+        monkeypatch.setattr(convolution, "get_vector_num", lambda: 64 // bt)
+        original = convolution.causal_conv1d_bwd_kernel
+        launches = []
+
+        class TileProbe:
+            def __getitem__(self, grid):
+                launch = original[grid]
+
+                def traced(*args, **kwargs):
+                    launches.append(kwargs["BT"])
+                    return launch(*args, **kwargs)
+
+                return traced
+
+        monkeypatch.setattr(convolution, "causal_conv1d_bwd_kernel", TileProbe())
+        self._run_bwd_test(1, 64, 256, 4, dtype, activation=activation, initial_state=True)
+        assert launches == [bt], f"requested BT={bt}, actually exercised {launches}"
+
     def test_grad_with_bias(self):
