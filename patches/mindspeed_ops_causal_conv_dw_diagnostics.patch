+def _print_pair_metrics(name, reference, actual):
+    reference, actual = reference.detach().cpu().float(), actual.detach().cpu().float()
+    finite = torch.isfinite(reference).all() & torch.isfinite(actual).all()
+    if not finite.item():
+        print(
+            f"CONV-BWD {name}: ref_nonfinite={(~torch.isfinite(reference)).sum().item()} "
+            f"actual_nonfinite={(~torch.isfinite(actual)).sum().item()}", flush=True,
+        )
+        return
+    ref_norm, act_norm = reference.norm(), actual.norm()
+    delta = actual - reference
+    cosine = (reference.flatten() @ actual.flatten()) / (ref_norm * act_norm).clamp_min(1e-24)
+    print(
+        f"CONV-BWD {name}: ref_norm={ref_norm.item():.6e} actual_norm={act_norm.item():.6e} "
+        f"abs_l2={delta.norm().item():.6e} rel_l2={(delta.norm() / ref_norm.clamp_min(1e-24)).item():.6e} "
+        f"cosine={cosine.item():.9f} max_abs={delta.abs().max().item():.6e}", flush=True,
+    )
+
+
+def _check_gradient_pairs(pairs, *, atol, rtol):
+    # Print every pair before any assertion, so a dw failure cannot hide dh0.
+    for name, (reference, actual) in pairs.items():
+        _print_pair_metrics(name, reference, actual)
+    failures = []
+    for name, (reference, actual) in pairs.items():
+        try:
+            torch.testing.assert_close(actual, reference, atol=atol, rtol=rtol)
+        except AssertionError as exc:
+            failures.append(f"{name}: {exc}")
+    if failures:
+        raise AssertionError("\n".join(failures))
+
+
+def _diagnose_dw_tiles(arguments):
+    """Independent CPU formula for the actual per-tile weight-gradient buffers."""
+    x = arguments["x"].detach().cpu().float()
+    dz = arguments["dy"].detach().cpu().float()
+    h0 = arguments["initial_state"].detach().cpu().float()
+    if arguments["ACTIVATION"] in ("silu", "swish"):
+        z = arguments["y"].detach().cpu().float()
+        sigmoid = z.sigmoid()
+        dz = dz * sigmoid * (1 + z * (1 - sigmoid))
+    actual = arguments["dw"].detach().cpu().float()
+    bt, width = arguments["BT"], arguments["W"]
+    batch, length, channels = x.shape
+    chunks = (length + bt - 1) // bt
+    expected = torch.zeros_like(actual)
+    for b in range(batch):
+        for tile in range(chunks):
+            for lag in range(width):
+                for t in range(tile * bt, min((tile + 1) * bt, length)):
+                    # This kernel partitions dw by the input time index.
+                    if t + lag < length:
+                        expected[b * chunks + tile, width - 1 - lag] += dz[b, t + lag] * x[b, t]
+                    if t < lag:
+                        expected[b * chunks + tile, width - 1 - lag] += dz[b, t] * h0[b, :, width - lag + t]
+    print(f"CONV-BWD dw-tiles BT={bt} BD={arguments['BD']} shape={tuple(actual.shape)}", flush=True)
+    for w in range(width):
+        _print_pair_metrics(f"dw-tiles/weight-row{w}", expected[:, w], actual[:, w])
+    error = (actual - expected).abs()
+    ranking = torch.nan_to_num(error, nan=float("inf"), posinf=float("inf"), neginf=float("inf"))
+    offset = ranking.flatten().argmax().item()
+    tile, remainder = divmod(offset, width * channels)
+    row, channel = divmod(remainder, channels)
+    print(
+        f"CONV-BWD dw-tiles worst tile={tile} row={row} channel={channel} "
+        f"expected={expected[tile, row, channel].item()} actual={actual[tile, row, channel].item()}",
+        flush=True,
+    )
+
+
